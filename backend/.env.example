# ===== Server =====
NODE_ENV=production
PORT=3000
# Domain frontend yang diizinkan (pisahkan dengan koma). Kosongkan jika web & API satu domain.
CORS_ORIGINS=https://absensi.domainanda.com
# Set "1" jika API berada di belakang Nginx/reverse proxy (agar IP & rate limit benar)
TRUST_PROXY=1

# ===== Oracle Database =====
DB_USER=absensi
DB_PASSWORD=GantiDenganPasswordKuat
# Format: host:port/service_name
DB_CONNECT_STRING=localhost:1521/FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=10

# ===== Keamanan =====
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=12h
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Maks. percobaan login per IP per 15 menit (semua pegawai di satu kantor/WiFi berbagi IP yang sama)
LOGIN_RATE_LIMIT=20

# ===== Absensi =====
APP_TIMEZONE=Asia/Jakarta
# Akurasi GPS maksimum (meter) yang diterima saat absen
MAX_GPS_ACCURACY_M=100
# Tolak absensi jika perangkat Android melaporkan lokasi palsu (mock location)
REJECT_MOCK_LOCATION=true

# ===== Upload foto laporan =====
# Folder penyimpanan foto/tanda tangan (di Docker: volume /app/uploads)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
